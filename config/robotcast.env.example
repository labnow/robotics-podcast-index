# Copy values into ~/.config/robotcast/robotcast.env. Do not commit that file.
ROBOTCAST_PAGES_REMOTE=git@github.com:OWNER/robotics-podcast-index.git

# Optional runtime tuning.
# ROBOTCAST_REQUEST_INTERVAL=3
# ROBOTCAST_CLASSIFY_BATCH=100
# ROBOTCAST_CLASSIFY_WORKERS=2
# ROBOTCAST_TRANSCRIBE_BATCH=50
# ROBOTCAST_TRANSCRIBE_BACKEND=faster-whisper
# ROBOTCAST_TRANSCRIBE_ENV=robotcast-faster-whisper-gpu
# ROBOTCAST_TRANSCRIBE_INFERENCE_BATCH=4
# ROBOTCAST_TRANSCRIBE_COMPUTE_TYPE=float16
# For faster-whisper, install nvidia-cublas-cu12 and nvidia-cudnn-cu12 in the runtime env.
# ROBOTCAST_QUALITY_BATCH=100
# ROBOTCAST_QUALITY_WORKERS=2
