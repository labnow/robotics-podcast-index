[Unit]
Description=Robotcast queued GPU transcription on physical GPU %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_DIR@
Environment=PATH=@CONDA_DIR@:@CODEX_DIR@:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-%h/.config/robotcast/robotcast.env
ExecStart=@PROJECT_DIR@/scripts/background_worker.sh transcribe %i
ExecStopPost=@PROJECT_DIR@/scripts/background_worker.sh release-transcription-claim %i
Nice=10

[Install]
WantedBy=default.target
