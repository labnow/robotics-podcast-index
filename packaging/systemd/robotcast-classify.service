[Unit]
Description=Robotcast queued episode classification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_DIR@
Environment=PATH=@CONDA_DIR@:@CODEX_DIR@:/usr/local/bin:/usr/bin:/bin
ExecStart=@PROJECT_DIR@/scripts/background_worker.sh classify
Nice=10

[Install]
WantedBy=default.target
